#!/bin/sh
# Rejects commit messages that don't follow Conventional Commits.
# See CONTRIBUTING.md. Turn on with: git config core.hooksPath .githooks

first_line=$(head -n 1 "$1")

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|test|refactor|perf|build|ci|chore)(\([a-z0-9-]+\))?!?: [^ ].*$'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "Commit message doesn't follow Conventional Commits:" >&2
  echo "  $first_line" >&2
  echo "Expected: <type>(<optional scope>): <summary>, e.g. 'fix(organise): keep numbering order'" >&2
  echo "Types: feat fix docs test refactor perf build ci chore. See CONTRIBUTING.md." >&2
  exit 1
fi

if [ ${#first_line} -gt 100 ]; then
  echo "Commit summary is ${#first_line} characters; keep it under about 72 (100 at most)." >&2
  exit 1
fi
